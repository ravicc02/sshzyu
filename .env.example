# =============================================================================
# SSHZYU 统一本地栈 — 环境配置
# =============================================================================
# 使用方法：
#   cp .env.example .env
#   # 编辑下面的 POSTGRES_PASSWORD 等，然后：
#   docker compose up -d --build
# =============================================================================

# ---- 端口 / 绑定 ----
# 前端 nginx 固定监听 127.0.0.1:8080（见 docker-compose.yml）
# 后端 API 直接绑定到下列地址（一般无需改动，nginx 会代理到它）
BIND_HOST=127.0.0.1
SERVER_PORT=8081

# ---- 数据库（必填） ----
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=change_me_use_openssl_rand_hex_16
POSTGRES_DB=sub2api

# ---- Redis ----
REDIS_PASSWORD=

# ---- 管理员账号（首次启动自动创建） ----
ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=change_me

# ---- 密钥（建议填写固定值） ----
# 留空则每次重启随机生成，会导致登录态失效 / 2FA 配置失效
# 生成方式：openssl rand -hex 32
JWT_SECRET=
TOTP_ENCRYPTION_KEY=

# ---- 运行模式 ----
# release | debug
SERVER_MODE=debug
RUN_MODE=standard

# ---- 时区 ----
TZ=Asia/Shanghai

# ---- 本地镜像 tag（build 出的镜像名 local/sshzyu:<tag>） ----
SUB2API_TAG=dev

# ---- 容器出网代理（可选，默认留空 = 直连） ----
# 国内网络环境如需走本机代理（例如 Clash 监听 7897）：
#   CONTAINER_HTTP_PROXY=http://host.docker.internal:7897
#   CONTAINER_HTTPS_PROXY=http://host.docker.internal:7897
#   CONTAINER_ALL_PROXY=socks5://host.docker.internal:7897
CONTAINER_HTTP_PROXY=
CONTAINER_HTTPS_PROXY=
CONTAINER_ALL_PROXY=

# ---- 生图工作台静态产物路径 ----
# 源码已并入本仓库（image-playground/），产物由 scripts/build-playground.sh 同步到 playground/
# 缺失时 /image/ 路由返回 404，不影响其它功能
# IMAGE_PLAYGROUND_DIST=./playground