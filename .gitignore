# ---- 环境变量（含密钥，绝不入库） ----
.env
deploy/.env

# ---- 运行时数据（本地生成，不入库） ----
deploy/data/
deploy/postgres_data/
deploy/redis_data/
deploy/local-run-logs/

# ---- 构建产物 ----
frontend/dist/
frontend/node_modules/
frontend/coverage/
frontend/*.tsbuildinfo
# 生图工作台源码（统一仓库内，唯一源）；产物同步到 playground/，故此处忽略其 dist
image-playground/dist/
image-playground/node_modules/
image-playground/.wrangler/
backend/server.exe
tools/sshzy-updater/sshzy-updater.exe
tools/sshzy-updater/bin/
*.log

# ---- 操作系统 ----
.DS_Store
Thumbs.db

# ---- 编辑器 ----
.idea/
.vscode/
*.swp
*.swo
# ---- 构建中间产物（Docker 多阶段构建自行编译，不入库） ----
backend/internal/web/dist/

# ---- 临时代理工作树和 Python 缓存（不入版本库） ----
.claude/worktrees/
__pycache__/
*.py[cod]

# ---- 运营记录（不属于统一仓库版本管理） ----
records/

# ---- 本地规划/方案文档（保留本地，不入库、不对外） ----
plan_docs/

# ---- 本地批量生图测试素材（保留本地，不入库） ----
batch test/
